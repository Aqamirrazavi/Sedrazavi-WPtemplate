        "padding": { "unit": "px", "top": "90", "right": "20", "bottom": "80", "left": "20" }
      },
      "elements": [
        {
          "id": "uas_col_corp_hero",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "uas_wid_corp_hero",
              "elType": "widget",
              "widgetType": "uas_hero",
              "settings": {
                "badge_text": "مشاوره راهبردی و راهکارهای جامع سازمانی",
