{
  "version": "0.4",
  "title": "UAS - قالب آرشیو مقالات و دسته‌بندی‌ها (Theme Builder Archive Posts)",
  "type": "archive",
  "content": [
    {
      "id": "uas_sec_archive_header",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "background_background": "gradient",
        "background_color": "#111827",
        "background_color_b": "#1F2937",
        "padding": { "unit": "px", "top": "50", "right": "20", "bottom": "50", "left": "20" }
      },
      "elements": [
        {
          "id": "uas_col_archive_header",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "uas_wid_archive_title",
              "elType": "widget",
              "widgetType": "theme-archive-title",
              "settings": {
                "align": "right"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "uas_sec_archive_grid",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "padding": { "unit": "px", "top": "50", "right": "20", "bottom": "60", "left": "20" }
      },
      "elements": [
        {
          "id": "uas_col_archive_grid",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "uas_wid_archive_posts",
              "elType": "widget",
              "widgetType": "archive-posts",
              "settings": {
                "posts_per_page": 9,
                "columns": "3",
                "pagination_type": "numbers_and_prev_next"
              }
            }
          ]
        }
      ]
    }
  ]
}
