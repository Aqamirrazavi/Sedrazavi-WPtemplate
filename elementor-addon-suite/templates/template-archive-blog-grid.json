{
  "version": "0.4",
  "title": "UAS - قالب آرشیو مقالات و دسته‌بندی‌ها (Theme Builder Archive Posts)",
  "type": "archive",
  "content": [
    {
      "id": "uas_cnt_archive_header",
      "elType": "container",
      "isInner": false,
      "settings": {
        "background_background": "gradient",
        "background_color": "#111827",
        "background_color_b": "#1F2937",
        "padding": {
          "unit": "px",
          "top": "50",
          "right": "20",
          "bottom": "50",
          "left": "20"
        },
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "stretch",
        "flex_justify_content": "center"
      },
      "elements": [
        {
          "id": "uas_wid_archive_title",
          "elType": "widget",
          "widgetType": "theme-archive-title",
          "settings": {
            "align": "right"
          }
        }
      ]
    },
    {
      "id": "uas_cnt_archive_grid",
      "elType": "container",
      "isInner": false,
      "settings": {
        "padding": {
          "unit": "px",
          "top": "50",
          "right": "20",
          "bottom": "60",
          "left": "20"
        },
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "stretch",
        "flex_justify_content": "center"
      },
      "elements": [
        {
          "id": "uas_wid_archive_posts",
          "elType": "widget",
          "widgetType": "archive-posts",
          "settings": {
            "posts_per_page": 9,
            "columns": "3",
            "pagination_type": "numbers_and_prev_next"
          }
        }
      ]
    }
  ]
}