{
  "version": "0.4",
  "title": "UAS - پیشخوان آماری دستاوردها و شاخص‌های کلیدی (Stat Counter Section)",
  "type": "section",
  "content": [
    {
      "id": "uas_sec_stat_counter_01",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "padding": { "unit": "px", "top": "60", "right": "20", "bottom": "60", "left": "20" },
        "background_background": "classic",
        "background_color": "#F8FAFC"
      },
      "elements": [
        {
          "id": "uas_col_stat_counter_01",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "uas_wid_stat_counter_01",
              "elType": "widget",
              "widgetType": "uas_stat_counter",
              "settings": {
                "columns": "4",
                "duration": 2200,
                "stats_list": [
                  {
                    "number": 1500,
                    "suffix": "+",
                    "title": "پروژه موفق پیاده‌سازی‌شده",
                    "description": "در سراسر کشور و خارج از مرزها",
                    "icon": "🚀"
                  },
                  {
                    "number": 99,
                    "suffix": "%",
                    "title": "شاخص رضایت کارفرمایان",
                    "description": "پایش مستمر کیفیت خدمات",
                    "icon": "⭐"
                  },
                  {
                    "number": 48,
                    "suffix": "+",
                    "title": "تخصص و سرویس سازمانی",
                    "description": "طراحی، امنیت و توسعه اختصاصی",
                    "icon": "🛡️"
                  },
                  {
                    "number": 24,
                    "suffix": "/7",
                    "title": "پشتیبانی و مانیتورینگ زنده",
                    "description": "پاسخگویی سریع در تمام روزهای سال",
                    "icon": "🎯"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
