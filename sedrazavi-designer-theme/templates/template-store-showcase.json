        "background_background": "classic",
        "background_color": "#0B132B",
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "stretch",
        "flex_justify_content": "center"
      },
      "elements": [
        {
          "id": "uas_wid_store_trust_grid",
          "elType": "widget",
          "widgetType": "uas_services_grid",
          "settings": {
