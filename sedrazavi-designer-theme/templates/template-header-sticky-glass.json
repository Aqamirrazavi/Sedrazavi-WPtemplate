{
  "version": "0.4",
  "title": "UAS - سربرگ مدرن شیشه‌ای و چسبان (Theme Builder Sticky Glass Header)",
  "type": "header",
  "content": [
    {
      "id": "uas_cnt_header_glass",
      "elType": "container",
      "isInner": false,
      "settings": {
        "background_background": "classic",
        "background_color": "rgba(15, 23, 42, 0.88)",
        "padding": {
          "unit": "px",
          "top": "16",
          "right": "24",
          "bottom": "16",
          "left": "24"
        },
        "content_width": "boxed",
        "flex_direction": "row",
        "flex_align_items": "stretch",
        "flex_justify_content": "center",
        "flex_wrap": "wrap",
        "flex_gap": {
          "unit": "px",
          "size": 24
        }
      },
      "elements": [
        {
          "id": "uas_cnt_sub_header_logo",
          "elType": "container",
          "isInner": true,
          "settings": {
            "width": {
              "unit": "%",
              "size": 25
            },
            "flex_direction": "column",
            "flex_align_items": "stretch"
          },
          "elements": [
            {
              "id": "uas_wid_site_logo",
              "elType": "widget",
              "widgetType": "theme-site-logo",
              "settings": {
                "align": "right"
              }
            }
          ]
        },
        {
          "id": "uas_cnt_sub_header_menu",
          "elType": "container",
          "isInner": true,
          "settings": {
            "width": {
              "unit": "%",
              "size": 50
            },
            "flex_direction": "column",
            "flex_align_items": "stretch"
          },
          "elements": [
            {
              "id": "uas_wid_nav_menu",
              "elType": "widget",
              "widgetType": "nav-menu",
              "settings": {
                "layout": "horizontal",
                "align_items": "center",
                "pointer": "underline"
              }
            }
          ]
        },
        {
          "id": "uas_cnt_sub_header_cta",
          "elType": "container",
          "isInner": true,
          "settings": {
            "width": {
              "unit": "%",
              "size": 25
            },
            "flex_direction": "column",
            "flex_align_items": "stretch"
          },
          "elements": [
            {
              "id": "uas_wid_header_btn",
              "elType": "widget",
              "widgetType": "button",
              "settings": {
                "text": "درخواست مشاوره آنلاین",
                "link": {
                  "url": "#contact"
                },
                "align": "left",
                "size": "sm"
              }
            }
          ]
        }
      ]
    }
  ]
}