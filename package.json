{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && rm -rf public/app-dist wordpress-theme/app-dist wordpress-theme/assets/dist wordpress-theme/assets/index.js wordpress-theme/assets/index.css && mkdir -p public/app-dist wordpress-theme/app-dist && cp -r dist/assets/* public/app-dist/ && cp -r dist/assets/* wordpress-theme/app-dist/",
    "preview": "vite preview",
    "package:theme": "node scripts/package-theme.js",
    "sync:all": "node scripts/sync-theme-to-ts.cjs && node scripts/sync-plugin-to-ts.cjs",
    "test:inc": "node scripts/test-inc-completeness.cjs",
    "test:css": "node scripts/test-css-coverage.cjs",
    "test:all": "node scripts/test-inc-completeness.cjs && node scripts/test-css-coverage.cjs",
    "clean": "rm -rf dist public/app-dist wordpress-theme/app-dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/jszip": "^3.4.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
