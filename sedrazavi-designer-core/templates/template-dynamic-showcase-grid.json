{
  "version": "0.4",
  "title": "UAS - گرید پویای مقالات، نمونه‌کارها و خدمات (Dynamic Query Showcase)",
  "type": "container",
  "content": [
    {
      "id": "uas_cnt_dynamic_grid_01",
      "elType": "container",
      "isInner": false,
      "settings": {
        "padding": {
          "unit": "px",
          "top": "60",
          "right": "20",
          "bottom": "60",
          "left": "20"
        },
        "background_background": "classic",
        "background_color": "#F8FAFC",
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "stretch",
        "flex_justify_content": "center"
      },
      "elements": [
        {
          "id": "uas_wid_dynamic_grid_01",
          "elType": "widget",
          "widgetType": "uas_dynamic_grid",
          "settings": {
            "columns": "3",
            "query_post_type": "post",
            "query_posts_per_page": 6,
            "query_orderby": "date",
            "query_order": "DESC",
            "query_cache_ttl": 3600,
            "btn_text": "مطالعه مقاله کامل ↗"
          }
        }
      ]
    }
  ]
}